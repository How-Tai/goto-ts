{
  "name": "@otog/api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "node dev.js",
    "build": "tsup",
    "start": "node --enable-source-maps --env-file=.env dist/index.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test:chat-auth": "node test/chat-auth-security.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@nestjs/common": "11.1.18",
    "@nestjs/core": "11.1.18",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/platform-socket.io": "11.1.18",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/websockets": "11.1.18",
    "@otog/contract": "workspace:*",
    "@otog/database": "workspace:*",
    "@scalar/nestjs-api-reference": "^0.3.190",
    "@softnetics/dev-server": "^0.0.2",
    "@ts-rest/core": "3.53.0-rc.1",
    "@ts-rest/nest": "3.53.0-rc.1",
    "@types/passport-jwt": "^3.0.13",
    "cookie-parser": "^1.4.7",
    "fs-extra": "^11.4.1",
    "js-sha256": "^0.9.0",
    "mime-types": "^2.1.35",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-lib": "1.17.1",
    "remeda": "^2.54.1",
    "socket.io": "^4.8.4",
    "ts-pattern": "^5.9.2",
    "unzipper": "^0.10.14",
    "uuid": "11.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@otog/workspace": "workspace:^",
    "@swc/core": "^1.16.20",
    "@types/cookie-parser": "^1.4.10",
    "@types/estree": "^1.0.9",
    "@types/express": "^4.17.25",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^26.0.24",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.13",
    "@types/node": "20.17.16",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^2.0.16",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
