{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["API_HOST_SSR", "PORT"],
  "tasks": {
    "build": {
      "dependsOn": ["^codegen", "^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "codegen": {
      "dependsOn": ["^codegen"],
      "outputs": ["__generated__/**", "dist/**"]
    },
    "codegen:watch": {
      "dependsOn": ["^codegen"],
      "outputs": ["__generated__/**", "dist/**"]
    }
  },
  "ui": "tui"
}
