# Derived from Moby's container profile; Isolate additionally needs mount setup.
# Keep this profile enforcing. The container capability set separately controls
# which operations root may perform; contestant and checker UIDs have no caps.
abi <abi/3.0>,
#include <tunables/global>
profile otog-grader flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  deny network alg,
  deny network vsock,
  capability,
  file,
  mount options=(rw,rprivate) -> /,
  remount /sys/fs/cgroup/,
  mount -> /var/local/lib/isolate/**,
  umount /var/local/lib/isolate/**,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=dockerd,
  signal (send,receive) peer=otog-grader,
  ptrace (trace,tracedby,read,readby) peer=otog-grader,
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
